# Copy to .env and fill in values from your Supabase project (Settings -> API).
# Only publishable (anon) keys belong here. Never commit a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Server-only: needed for the AI mentor and quiz grading (Lovable AI Gateway)
LOVABLE_API_KEY=
